{
  "$schema": "./node_modules/wrangler/config-schema.json",
  "name": "chanya-jp",
  "main": "./src/index.tsx",
  "compatibility_date": "2026-07-25",
  "workers_dev": true,
  "preview_urls": true,
  "routes": [
    {
      "pattern": "chanya.jp/*",
      "zone_name": "chanya.jp"
    }
  ],
  "observability": {
    "enabled": true,
    "logs": {
      "enabled": true,
      "invocation_logs": true
    }
  }
}
