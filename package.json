{
  "name": "chanya-jp",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=22.12.0"
  },
  "scripts": {
    "assets:build": "tsx scripts/build-assets.ts",
    "cf-typegen": "wrangler types worker-configuration.d.ts --env-interface CloudflareBindings --include-runtime false && wrangler types worker-runtime.d.ts --include-env false --include-runtime true",
    "dev": "npm run assets:build && vite",
    "typecheck": "tsc -p tsconfig.worker.json --noEmit && tsc -p tsconfig.browser.json --noEmit",
    "test": "vitest run",
    "test:e2e": "playwright test",
    "audit:lighthouse": "tsx scripts/lighthouse.ts",
    "build": "npm run assets:build && npm run cf-typegen && npm run typecheck && vite build",
    "preview": "npm run build && vite preview",
    "check": "npm run test && npm run build",
    "deploy": "npm run build && wrangler deploy"
  },
  "dependencies": {
    "@fontsource-variable/inter": "^5.3.0",
    "@fontsource-variable/jetbrains-mono": "^5.3.0",
    "@fontsource-variable/space-grotesk": "^5.3.0",
    "@vanilla-extract/css": "^1.21.1",
    "hono": "^4.12.32",
    "jose": "^6.2.4",
    "zod": "^4.4.3"
  },
  "devDependencies": {
    "@axe-core/playwright": "^4.12.1",
    "@cloudflare/vite-plugin": "^1.47.0",
    "@playwright/test": "^1.62.0",
    "@types/node": "^26.1.1",
    "@vanilla-extract/vite-plugin": "^5.2.5",
    "chrome-launcher": "^1.2.1",
    "lighthouse": "^13.4.1",
    "sharp": "^0.35.3",
    "tsx": "^4.23.1",
    "typescript": "^7.0.2",
    "vite": "^8.1.5",
    "vite-ssr-components": "^0.6.1",
    "vitest": "^4.1.10",
    "wrangler": "^4.114.0"
  }
}
